{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale de Cobblestone.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",

    "dialog:allow-open",
    "store:default",

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",

    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git-root",
          "cmd": "git",
          "args": [
            "-C",
            { "validator": "^[^\\r\\n]+$" },
            "rev-parse",
            "--show-toplevel"
          ]
        },
        {
          "name": "git-log",
          "cmd": "git",
          "args": [
            "-C",
            { "validator": "^[^\\r\\n]+$" },
            "log",
            "--follow",
            { "validator": "^--format=.+$" },
            "-n",
            { "validator": "^[0-9]{1,4}$" },
            "--",
            { "validator": "^[^\\r\\n]+$" }
          ]
        }
      ]
    }
  ]
}
